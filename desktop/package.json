{
  "name": "lafouch-desktop",
  "version": "1.0.0",
  "description": "La Fouch - Tudo em Óculos (Windows)",
  "main": "main.js",
  "author": "La Fouch",
  "private": true,
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "py.lafouch.app",
    "productName": "La Fouch",
    "directories": { "output": "dist" },
    "files": ["main.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "win": { "target": "nsis", "icon": "icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true }
  }
}
